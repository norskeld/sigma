{
  "name": "sigma",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "pnpm build && pnpm --filter @nrsk/sigma-bench bench",
    "build": "pnpm --filter @nrsk/sigma build",
    "build:watch": "pnpm --filter @nrsk/sigma build:watch",
    "changeset": "changeset",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "docs:build": "pnpm --filter @nrsk/sigma-docs build",
    "docs:dev": "pnpm --filter @nrsk/sigma-docs dev",
    "prepare": "lefthook install",
    "release": "pnpm build && changeset publish",
    "test": "pnpm --filter @nrsk/sigma test",
    "test:coverage": "pnpm --filter @nrsk/sigma test:coverage",
    "test:types": "pnpm --filter @nrsk/sigma test:types",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "version": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/changelog-github": "1.0.0-next.8",
    "@changesets/cli": "3.0.0-next.10",
    "@nrsk/tsconfig": "workspace:*",
    "lefthook": "2.1.10",
    "publint": "0.3.21",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.10.0"
}
